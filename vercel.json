{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/assets/Bing:rest(.*)\\.pdf",
      "destination": "/assets/Bingaa.pdf"
    },
    {
      "source": "/assets/Bing:rest(.*)Cover(.*)",
      "destination": "/assets/BingaaCover.png"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
