{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "headers": [
    {
      "source": "/(.*)\\.(mp4|mov|webm)",
      "headers": [
        { "key": "Accept-Ranges", "value": "bytes" },
        { "key": "Content-Type", "value": "video/mp4" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/nfc/send-pin",
      "destination": "/api?__path=nfc/register"
    },
    {
      "source": "/api/nfc/verify",
      "destination": "/api?__path=nfc/redeem"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api?__path=$1"
    },
    {
      "source": "/assets/Bing:rest(.*)\\.pdf",
      "destination": "/assets/Bingaa.pdf"
    },
    {
      "source": "/assets/Bing:rest(.*)Cover(.*)",
      "destination": "/assets/BingaaCover.png"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
